{
    "$schema": "./@types/schema/package/index.json",
    "package_version": 2,
    "name": "taowu-inspector",
    "version": "1.0.0",
    "author": "TaoWu",
    "editor": ">=3.8.5",
    "main": "./dist/main.js",
    "scripts": {
        "build": "tsc",
        "watch": "tsc -w",
        "test": "tsc && node --test dist/test/"
    },
    "description": "TaoWu Inspector — 属性绘制插件",
    "devDependencies": {
        "@cocos/creator-types": "^3.8.5",
        "@types/node": "^18.17.1",
        "typescript": "^5.8.2"
    },
    "contributions": {
        "inspector": {
            "section": {
                "node": {
                    "TaoWuCompoent": "./dist/inspector/taowu-renderer.js"
                }
            }
        },
        "scene": {
            "script": "./dist/scene-script.js"
        },
        "menu": [
            {
                "path": "TaoWuInspector/Install",
                "label": "导入Runtime脚本",
                "message": "installRuntime"
            },
            {
                "path": "TaoWuInspector/Example",
                "label": "导入示例",
                "message": "importExample"
            }
        ],
        "messages": {
            "query-taowu-metadata": {
                "methods": ["queryTaoWuMetadata"]
            },
            "resolve-value-dropdown": {
                "methods": ["resolveValueDropdown"]
            },
            "installRuntime": {
                "methods": ["installRuntime"]
            },
            "importExample": {
                "methods": ["importExample"]
            }
        }
    }
}
